# OpenAI API 키 (필수) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Vercel Blob 토큰 (페이스북 공유 링크용, 선택)
# Vercel 대시보드 > Storage > Blob 생성 후 프로젝트에 연결하면 자동으로 들어갑니다.
BLOB_READ_WRITE_TOKEN=

# 선택 설정
# IMAGE_MODEL=gpt-image-2.5-sunburst
# TEXT_MODEL=gpt-5.6-terra
# IMAGE_QUALITY=medium        # low | medium | high | xhigh | max
# TEXT_REASONING=low          # none | low | medium | high
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
